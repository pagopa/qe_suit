<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!--
        Garantisce il flush degli appender alla chiusura della JVM.
        Utile soprattutto in caso di run interrotti o failure molto rapide.
    -->
    <shutdownHook class="ch.qos.logback.core.hook.DefaultShutdownHook"/>

    <property name="LOG_DIR" value="target/logs"/>

    <!--
        Livello della suite configurabile tramite:
        -DSUIT_LOG_LEVEL=DEBUG
        oppure variabile ambiente:
        SUIT_LOG_LEVEL=DEBUG

        Default: INFO
    -->
    <property name="suitLogLevel" value="${SUIT_LOG_LEVEL:-INFO}"/>

    <!--
        Pattern completo per il file.

        testCaseId:
        identifica il caso di test logico.

        testExecutionId:
        identifica la singola esecuzione.
        Negli Scenario Outline consente di distinguere Example 1, Example 2, ecc.

        "bootstrap" indica log prodotti prima che un test abbia popolato l'MDC.
        Esempio: bootstrap del contesto Spring.

        La colonna testCaseId mantiene larghezza fissa a 48 caratteri
        per semplificare eventuali elaborazioni CI.
    -->
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%-48.-48X{testCaseId:-bootstrap}] [%X{testExecutionId:-bootstrap}] [%thread] %logger{36} - %msg%n"/>

    <!--
        Pattern console più compatto.

        Viene mostrato testExecutionId invece di testCaseId perché:
        - negli scenari normali coincidono;
        - negli Scenario Outline executionId distingue i singoli Example.

        Il thread è mantenuto perché utile durante l'esecuzione parallela.
    -->
    <property name="CONSOLE_PATTERN"
              value="%d{HH:mm:ss.SSS} %-5level [%X{testExecutionId:-bootstrap}] [%thread] %logger{28} - %msg%n"/>


    <!-- =========================================================
         APPENDERS
         ========================================================= -->

    <appender name="CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">

        <encoder>
            <pattern>${CONSOLE_PATTERN}</pattern>
        </encoder>
    </appender>

    <!--
        File unico contenente:
        - framework E2E
        - step Cucumber
        - chiamate HTTP
        - log applicativi della suite

        append=true:
        ogni esecuzione aggiunge i log al file esistente.
    -->
    <appender name="TEST_FILE"
              class="ch.qos.logback.core.FileAppender">

        <file>${LOG_DIR}/qa-test.log</file>
        <append>true</append>

        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>


    <!-- =========================================================
         LOGGER DELLA SUITE
         ========================================================= -->

    <!--
        Framework E2E:
        interazioni UI, navigation, wait, retry, Selenium adapter.
    -->
    <logger name="it.frontend.e2e.framework"
            level="${suitLogLevel}"
            additivity="false">

        <appender-ref ref="TEST_FILE"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!--
        Step, hook e domini della suite Interop.
    -->
    <logger name="it.pagopa.interop"
            level="${suitLogLevel}"
            additivity="false">

        <appender-ref ref="TEST_FILE"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!--
        Modulo infrastructure/common:
        HttpLoggingFilter, contract validation e infrastruttura condivisa.
    -->
    <logger name="it.pagopa.infrastructure"
            level="${suitLogLevel}"
            additivity="false">

        <appender-ref ref="TEST_FILE"/>
        <appender-ref ref="CONSOLE"/>
    </logger>


    <!-- =========================================================
         THIRD-PARTY NOISE
         ========================================================= -->

    <logger name="org.springframework" level="WARN"/>
    <logger name="org.openqa.selenium" level="WARN"/>
    <logger name="org.apache.hc" level="WARN"/>
    <logger name="io.restassured" level="WARN"/>
    <logger name="io.cucumber" level="INFO"/>


    <!-- =========================================================
         ROOT LOGGER
         ========================================================= -->

    <!--
        WARN evita che librerie non esplicitamente configurate
        riempiano console ed e2e.log con log INFO non rilevanti.

        I package della suite restano comunque a suitLogLevel
        perché configurati esplicitamente sopra.
    -->
    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="TEST_FILE"/>
    </root>

</configuration>