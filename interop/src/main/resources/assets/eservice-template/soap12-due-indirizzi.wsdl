<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:tns="urn:pagopa:pin10024:soap12:two"
                  xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:s12="http://schemas.xmlsoap.org/wsdl/soap12/"
                  targetNamespace="urn:pagopa:pin10024:soap12:two">
    <wsdl:types>
        <xsd:schema targetNamespace="urn:pagopa:pin10024:soap12:two">
            <xsd:element name="request" type="xsd:string"/>
        </xsd:schema>
    </wsdl:types>
    <wsdl:message name="request">
        <wsdl:part name="body" element="tns:request"/>
    </wsdl:message>
    <wsdl:portType name="ServizioPagamenti">
        <wsdl:operation name="paga">
            <wsdl:input message="tns:request"/>
        </wsdl:operation>
    </wsdl:portType>
    <wsdl:binding name="bindingUno" type="tns:ServizioPagamenti">
        <s12:binding style="document" transport="http://www.w3.org/2003/05/soap/bindings/HTTP/"/>
        <wsdl:operation name="paga">
            <s12:operation soapAction="urn:paga"/>
            <wsdl:input>
                <s12:body use="literal"/>
            </wsdl:input>
        </wsdl:operation>
    </wsdl:binding>
    <wsdl:binding name="bindingDue" type="tns:ServizioPagamenti">
        <s12:binding style="document" transport="http://www.w3.org/2003/05/soap/bindings/HTTP/"/>
        <wsdl:operation name="paga">
            <s12:operation soapAction="urn:paga"/>
            <wsdl:input>
                <s12:body use="literal"/>
            </wsdl:input>
        </wsdl:operation>
    </wsdl:binding>
    <wsdl:service name="ServizioPagamenti">
        <wsdl:port name="PortaUno" binding="tns:bindingUno">
            <s12:address location="https://originale.example/uno"/>
        </wsdl:port>
        <wsdl:port name="PortaDue" binding="tns:bindingDue">
            <s12:address location="https://originale.example/due"/>
        </wsdl:port>
    </wsdl:service>
</wsdl:definitions>
