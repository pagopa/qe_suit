<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.3</version>
        <relativePath/>
    </parent>

    <groupId>it.example.pst</groupId>
    <artifactId>pst-e2e-fixture</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <java.version>17</java.version>
        <widget.openapi.url>${project.basedir}/src/main/openapi/widget.yaml</widget.openapi.url>
        <other.openapi.url>${project.basedir}/src/main/openapi/other.yaml</other.openapi.url>
    </properties>

    <dependencies>
        <dependency>
            <groupId>it.pagopa</groupId>
            <artifactId>common</artifactId>
            <version>@pst.common.version@</version>
        </dependency>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.code.findbugs</groupId>
            <artifactId>jsr305</artifactId>
            <version>3.0.2</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <version>7.24.0</version>
                <configuration>
                    <generatorName>java</generatorName>
                    <library>rest-assured</library>
                    <generateApiTests>false</generateApiTests>
                    <generateModelTests>false</generateModelTests>
                    <generateApiDocumentation>false</generateApiDocumentation>
                    <generateModelDocumentation>false</generateModelDocumentation>
                </configuration>
                <executions>
                    <execution>
                        <id>generate-widget-client</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <phase>process-resources</phase>
                        <configuration>
                            <inputSpec>${widget.openapi.url}</inputSpec>
                            <configOptions>
                                <apiPackage>it.example.pst.generated.widget.api</apiPackage>
                                <modelPackage>it.example.pst.generated.widget.model</modelPackage>
                                <invokerPackage>it.example.pst.generated.widget.invoker</invokerPackage>
                                <dateLibrary>java8</dateLibrary>
                                <openApiNullable>false</openApiNullable>
                                <useJakartaEe>true</useJakartaEe>
                                <useBeanValidation>true</useBeanValidation>
                                <performBeanValidation>false</performBeanValidation>
                                <serializationLibrary>jackson</serializationLibrary>
                            </configOptions>
                        </configuration>
                    </execution>
                    <!-- Second codegen: proves the goal selects by execution id, without fallback. -->
                    <execution>
                        <id>generate-other-client</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <phase>process-resources</phase>
                        <configuration>
                            <inputSpec>${other.openapi.url}</inputSpec>
                            <output>${project.build.directory}/generated-sources/openapi-other</output>
                            <configOptions>
                                <apiPackage>it.example.pst.generated.other.api</apiPackage>
                                <modelPackage>it.example.pst.generated.other.model</modelPackage>
                                <invokerPackage>it.example.pst.generated.other.invoker</invokerPackage>
                                <dateLibrary>java8</dateLibrary>
                                <openApiNullable>false</openApiNullable>
                                <useJakartaEe>true</useJakartaEe>
                                <useBeanValidation>true</useBeanValidation>
                                <performBeanValidation>false</performBeanValidation>
                                <serializationLibrary>jackson</serializationLibrary>
                            </configOptions>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
